PORT=8080
# Replace both passwords (at least 8 characters) and the JWT key before starting.
# The server rejects these public placeholders; generate a random 32-byte key.
APP_PASSWORD=change-me
ADMIN_PASSWORD=change-me
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRE=24h
DB_PATH=data/todayeat.db
UPLOAD_DIR=uploads
BACKUP_DIR=uploads_backup
MAX_UPLOAD_SIZE_MB=20
COMPRESS_MAX_DIM=1200
JPEG_QUALITY=85
# AMAP_KEY=
# AMAP_CITY=
